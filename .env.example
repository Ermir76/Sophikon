# Copy this file to .env and fill in the values
# cp .env.example .env

# PostgreSQL password (used by docker-compose for both the DB and backend)
POSTGRES_PASSWORD=choose-a-dev-password

# AI service shared secret for backend <-> ai-service authentication
AI_SERVICE_SHARED_SECRET=dev-ai-shared-secret

# AI mode for ai-service (mock|live)
AI_MODE=mock
