      "fontSize": 18,
      "fontFamily": 1,
      "text": "FastAPI auth API\n\nRoutes under /api/v1/auth\n- register / login\n- me / refresh / logout\n- verify-email / resend verification\n- password-reset / confirm\n- change-password\n- oauth/google / callback\n\nAuth dependencies\n- cookie first\n- bearer fallback\n- active-user check",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FastAPI auth API\n\nRoutes under /api/v1/auth\n- register / login\n- me / refresh / logout\n- verify-email / resend verification\n- password-reset / confirm\n- change-password\n- oauth/google / callback\n\nAuth dependencies\n- cookie first\n- bearer fallback\n- active-user check",
      "lineHeight": 1.25,
      "baseline": 233
    },
